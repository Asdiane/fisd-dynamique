{
  "name": "web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "extract-i18n": "ngx-translate-extract --input ./src/app --output ./public/assets/i18n/fr.json ./public/assets/i18n/en.json --sort --format namespaced-json --clean --marker marker",
