    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@colsen1991/ngx-translate-extract-marker": "^3.0.1",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@simplewebauthn/browser": "^14.0.0",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.0",
    "@types/qrcode": "^1.5.6",
    "@vendure/ngx-translate-extract": "^9.4.2",
